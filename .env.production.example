# Copy this file to .env.production on the server. Never commit the copied file.
POSTGRES_DB=durableflow
POSTGRES_USER=durableflow
POSTGRES_PASSWORD=replace-with-a-long-random-password
DURABLEFLOW_OPERATOR_TOKEN=replace-with-a-long-random-operator-token
# Optional: comma-separated allowed origins; * is safe only while no browser credentials are used.
DURABLEFLOW_WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=*
